{
  "name": "staffpay-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "pretest": "npm run clean:results",
    "test": "playwright test",
    "pretest:headed": "npm run clean:results",
    "test:headed": "playwright test --headed",
    "pretest:watch": "npm run clean:results",
    "test:watch": "SLOW_MO=600 playwright test --headed --workers=1",
    "pretest:ui": "npm run clean:results",
    "test:ui": "playwright test --ui",
    "pretest:auth": "npm run clean:results",
    "test:auth": "playwright test --project=setup",
    "pretest:no-auth": "npm run clean:results",
    "test:no-auth": "playwright test --project=chromium --no-deps",
    "pretest:staff-creation": "npm run clean:results",
    "test:staff-creation": "SLOW_MO=600 playwright test tests/create-staff.e2e.spec.ts --project=\"Staff Creation\" --headed",
    "pretest:amazon-staff-creation": "npm run clean:results",
    "test:amazon-staff-creation": "SLOW_MO=600 playwright test tests/create-amazon-staff.e2e.spec.ts --project=\"Staff Creation\" --headed",
    "pretest:amazon-bgv-discrepant": "npm run clean:results",
    "test:amazon-bgv-discrepant": "SLOW_MO=600 playwright test tests/amazon-bgv-discrepant.e2e.spec.ts --project=\"Staff Creation\" --headed",
    "pretest:amazon-bgv-insufficient": "npm run clean:results",
    "test:amazon-bgv-insufficient": "SLOW_MO=600 playwright test tests/amazon-bgv-insufficient.e2e.spec.ts --project=\"Staff Creation\" --headed",
    "pretest:amazon-bgv-attention-required": "npm run clean:results",
    "test:amazon-bgv-attention-required": "SLOW_MO=600 playwright test tests/amazon-bgv-attention-required.e2e.spec.ts --project=\"Staff Creation\" --headed",
    "pretest:amazon": "npm run clean:results",
    "test:amazon": "playwright test tests/create-amazon-staff.e2e.spec.ts tests/amazon-bgv-discrepant.e2e.spec.ts tests/amazon-bgv-insufficient.e2e.spec.ts tests/amazon-bgv-attention-required.e2e.spec.ts --project=\"Staff Creation\" --workers=1; s=$?; npm run allure:generate; exit $s",
    "pretest:amazon:headed": "npm run clean:results",
    "test:amazon:headed": "SLOW_MO=300 playwright test tests/create-amazon-staff.e2e.spec.ts tests/amazon-bgv-discrepant.e2e.spec.ts tests/amazon-bgv-insufficient.e2e.spec.ts tests/amazon-bgv-attention-required.e2e.spec.ts --project=\"Staff Creation\" --workers=1 --headed; s=$?; npm run allure:generate; exit $s",
    "cleanup:kyc": "RUN_KYC_CLEANUP=true playwright test --project=\"KYC Cleanup\"",
    "clean:results": "rm -rf reports/allure-results",
    "report": "playwright show-report reports/html-report",
    "allure": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1142.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "dotenv": "^17.4.2",
    "mysql2": "^3.24.3"
  }
}
